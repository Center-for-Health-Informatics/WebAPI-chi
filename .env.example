# TCP address and port Express binds to
EXPRESS_PORT=80
EXPRESS_HOST=0.0.0.0

# TCP port exposed by the container
HTTP_PORT=8080

# Path to the SQLite database file
DB_PATH=/data/webapi.db

# Override Version string reported by GET /info
# WEBAPI_VERSION=2.15.1

# CHI Authentication signed assertion (recommended). When WEBAPI_SSO_JWKS_URL is
# set, every request must carry a valid ES256 `sso-assertion` header (forwarded by
# nginx from auth_request) whose iss/aud match the values below.
# WEBAPI_SSO_JWKS_URL=https://chi-tools.uc.edu/auth/.well-known/jwks.json
# WEBAPI_SSO_ISSUER=https://chi-tools.uc.edu/auth/
# WEBAPI_SSO_AUDIENCE=chi-tools.uc.edu

# Legacy, used only when WEBAPI_SSO_JWKS_URL is unset: unsigned header that
# carries the username. Anyone who can reach the port can forge it.
WEBAPI_AUTH_HEADER=x-forwarded-user

# Host address the published port binds to (deploy/compose.yaml only)
# BIND_ADDRESS=127.0.0.1

# JSON array of CDM source definitions.
# Each entry must have at minimum: sourceKey, sourceName, cdmSchema, vocabSchema,
# resultsSchema, tempSchema, and either connectionString or (server + database +
# username + password).
#
# Using a connection string:
# WEBAPI_SOURCES=[{"sourceKey":"cdm1","sourceName":"My CDM","connectionString":"Server=host,1433;Database=cdm;Encrypt=true;","username":"user","password":"pass","cdmSchema":"dbo","vocabSchema":"dbo","resultsSchema":"results","tempSchema":"temp"}]
#
# Using discrete properties:
# WEBAPI_SOURCES=[{"sourceKey":"cdm1","sourceName":"My CDM","server":"host","port":1433,"database":"cdm","username":"user","password":"pass","encrypt":true,"trustServerCertificate":false,"cdmSchema":"dbo","vocabSchema":"dbo","resultsSchema":"results","tempSchema":"temp"}]
WEBAPI_SOURCES=[]
